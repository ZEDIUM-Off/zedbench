# Workbench: machines, workspaces, worktrees, layouts and sessions.
# Mount it in the real window with "storybook: mount story": every slot below
# goes to its place in Zedbench, and the rest of the window stays the real one.
# - leftDock: the Workbench. Machines, their workspaces, the worktrees and
#   layouts of the open workspace;
# - rightDock: Sessions. Agents and terminals that hc keeps alive, and the
#   history of every session that ended;
# - statusStart, statusEnd: the active layout, and the agents waiting on you.
# The preview below lays the same slots side by side.

$workspace = "app"
$worktree = "checkout"
$layout = "app-impl"
$sessionsTab = 0
$onlyWorktree = false
$historyKind = 0
$query = ""

machines = [
  {id: "local", name: "workstation", detail: "this machine", icon: "screen"},
  {id: "build", name: "buildbox", detail: "ssh · 14 sessions", icon: "server"}
]

workspaces = [
  {id: "app", machine: "local", name: "acme-app", layout: "app-impl"},
  {id: "api", machine: "build", name: "acme-api", layout: "api-runs"},
  {id: "design", machine: "local", name: "design-system", layout: "ds-edit"},
  {id: "dots", machine: "local", name: "dotfiles", layout: "dots-edit"}
]

worktrees = [
  {id: "app-main", workspace: "app", branch: "main", path: "acme-app", ahead: "", changes: 0},
  {id: "checkout", workspace: "app", branch: "feat/checkout", path: ".worktrees/checkout", ahead: "+12", changes: 4},
  {id: "login", workspace: "app", branch: "fix/login-timeout", path: ".worktrees/login-timeout", ahead: "+3", changes: 0},
  {id: "api-main", workspace: "api", branch: "main", path: "acme-api", ahead: "", changes: 0},
  {id: "limits", workspace: "api", branch: "feat/rate-limit", path: ".worktrees/rate-limit", ahead: "+7", changes: 2},
  {id: "ds-main", workspace: "design", branch: "main", path: "design-system", ahead: "", changes: 1},
  {id: "dots-main", workspace: "dots", branch: "main", path: "dotfiles", ahead: "", changes: 0}
]

# Live sessions come from hc; kind is the label zedbench.kind, or the program
# hc reports (pi, claude, codex → agent). Sessions with status "off" ended:
# they come from the agents' own session files, and can be resumed.
sessions = [
  {id: "t11", workspace: "app", worktree: "checkout", kind: "agent", program: "pi", name: "Checkout flow", status: "working", turn: 62, when: "now"},
  {id: "t12", workspace: "app", worktree: "checkout", kind: "agent", program: "pi", name: "Review checkout", status: "blocked", turn: 4, when: "now"},
  {id: "t13", workspace: "app", worktree: "login", kind: "agent", program: "codex", name: "Login timeout", status: "done", turn: 38, when: "12 min ago"},
  {id: "t14", workspace: "app", worktree: "app-main", kind: "agent", program: "pi", name: "Release notes", status: "idle", turn: 7, when: "1 h ago"},
  {id: "t15", workspace: "app", worktree: "checkout", kind: "terminal", program: "zsh", name: "cargo watch -x test", status: "live", turn: 0, when: "now"},
  {id: "t16", workspace: "app", worktree: "app-main", kind: "terminal", program: "zsh", name: "Shell", status: "live", turn: 0, when: "now"},
  {id: "h1", workspace: "app", worktree: "checkout", kind: "agent", program: "pi", name: "Plan checkout", status: "off", turn: 21, when: "Today 09:40"},
  {id: "h2", workspace: "app", worktree: "login", kind: "agent", program: "pi", name: "Reproduce login bug", status: "off", turn: 15, when: "Yesterday"},
  {id: "h3", workspace: "app", worktree: "app-main", kind: "terminal", program: "zsh", name: "cargo build --release", status: "off", turn: 0, when: "Yesterday"},
  {id: "h4", workspace: "app", worktree: "app-main", kind: "agent", program: "claude", name: "Upgrade dependencies", status: "off", turn: 44, when: "Mon"},
  {id: "h5", workspace: "app", worktree: "app-main", kind: "agent", program: "pi", name: "Write onboarding docs", status: "off", turn: 9, when: "Last week"},
  {id: "t21", workspace: "api", worktree: "limits", kind: "agent", program: "pi", name: "Rate limiter", status: "working", turn: 15, when: "now"},
  {id: "t22", workspace: "api", worktree: "api-main", kind: "terminal", program: "sh", name: "Shell", status: "live", turn: 0, when: "now"},
  {id: "h6", workspace: "api", worktree: "limits", kind: "agent", program: "pi", name: "Design limits", status: "off", turn: 30, when: "Yesterday"},
  {id: "t31", workspace: "design", worktree: "ds-main", kind: "terminal", program: "zsh", name: "pnpm storybook", status: "live", turn: 0, when: "now"}
]

layouts = [
  {id: "app-impl", workspace: "app", name: "Implement", key: "1"},
  {id: "app-review", workspace: "app", name: "Review", key: "2"},
  {id: "app-agents", workspace: "app", name: "Agents", key: "3"},
  {id: "api-runs", workspace: "api", name: "Runs", key: "1"},
  {id: "ds-edit", workspace: "design", name: "Edit", key: "1"},
  {id: "dots-edit", workspace: "dots", name: "Edit", key: "1"}
]

ws = @First(@Filter(workspaces, "id", "==", $workspace))
wt = @First(@Filter(worktrees, "id", "==", $worktree))
current = @First(@Filter(layouts, "id", "==", $layout))
myLayouts = @Filter(layouts, "workspace", "==", $workspace)
mySessions = @Filter(sessions, "workspace", "==", $workspace)
scoped = $onlyWorktree ? @Filter(mySessions, "worktree", "==", $worktree) : mySessions
live = @Filter(@Filter(scoped, "status", "!=", "off"), "name", "contains", $query)
agents = @Filter(live, "kind", "==", "agent")
terms = @Filter(live, "kind", "==", "terminal")
ended = @Filter(@Filter(scoped, "status", "==", "off"), "name", "contains", $query)
history = $historyKind == 1 ? @Filter(ended, "kind", "==", "agent") : $historyKind == 2 ? @Filter(ended, "kind", "==", "terminal") : ended
blocked = @Filter(sessions, "status", "==", "blocked")
nothing = Column([], {width: 0})

root = Column([
  Row([leftDock, Divider(), Column([Text("The real panes of the window go here.", "muted")], {grow: true, padding: 12}), Divider(), rightDock], {grow: true, align: "stretch"}),
  Divider(),
  Row([statusStart, Spacer(), statusEnd], {gap: 6, padding: 2, surface: "status_bar"})
], {grow: true})

leftDock = Column([
  Row([Text("Workbench", "heading"), Spacer(), Button("", @ToAssistant("Open a workspace"), "ghost", false, "plus")], {gap: 6, padding: 6}),
  Column(@Each(machines, "m", Column([
    ListItem(m.name, null, false, m.icon, m.detail),
    Column(@Each(@Filter(workspaces, "machine", "==", m.id), "w", Column([
      ListItem(w.name, Action([@Set($workspace, w.id), @Set($layout, w.layout), @Set($worktree, @First(@Filter(worktrees, "workspace", "==", w.id)).id)]), $workspace == w.id, $workspace == w.id ? "folder_open" : "folder", null, 1, @Count(@Filter(@Filter(sessions, "workspace", "==", w.id), "status", "==", "blocked")) > 0 ? [Tag("!", "danger")] : []),
      $workspace == w.id ? Column([
        Text("Worktrees", "small"),
        Column(@Each(@Filter(worktrees, "workspace", "==", w.id), "t",
          ListItem(t.branch, @Set($worktree, t.id), $worktree == t.id, "git_branch", t.ahead + (t.changes > 0 ? " · " + t.changes + " changed" : ""), 2, [
            Tag(@Count(@Filter(@Filter(@Filter(sessions, "worktree", "==", t.id), "kind", "==", "agent"), "status", "!=", "off")) + " ag", @Count(@Filter(@Filter(sessions, "worktree", "==", t.id), "status", "==", "blocked")) > 0 ? "danger" : "secondary"),
            Tag(@Count(@Filter(@Filter(@Filter(sessions, "worktree", "==", t.id), "kind", "==", "terminal"), "status", "!=", "off")) + " sh", "secondary")
          ])
        )),
        ListItem("New worktree…", @ToAssistant("New worktree in " + w.name), false, "plus", null, 2),
        Text("Layouts", "small"),
        Column(@Each(myLayouts, "l", ListItem(l.name, @Set($layout, l.id), $layout == l.id, "split", "super+" + l.key, 2))),
        ListItem("New layout…", @ToAssistant("New layout in " + w.name), false, "plus", null, 2)
      ], {gap: 2}) : nothing
    ])))
  ], {gap: 2})), {gap: 6, grow: true, scroll: true, padding: 4})
], {grow: true, surface: "panel"})

statusStart = Row([
  Icon("split", "muted"),
  Text(ws.name + " · " + wt.branch + " ·", "small"),
  Row(@Each(myLayouts, "l", Button(l.name, @Set($layout, l.id), "ghost", $layout == l.id)), {gap: 2})
], {gap: 4})

statusEnd = Tag(@Count(blocked) + " need you", @Count(blocked) > 0 ? "danger" : "secondary")

rightDock = Column([
  Tabs(["Agents · " + @Count(agents), "Terminals · " + @Count(terms), "History · " + @Count(ended)], $sessionsTab),
  Input($query, "Filter sessions"),
  Switch("Only " + wt.branch, $onlyWorktree),
  $sessionsTab == 0 ? agentsView : $sessionsTab == 1 ? termsView : historyView
], {grow: true, padding: 6, gap: 6, surface: "panel", scroll: true})

agentsView = Column([
  Text("Needs you", "error"),
  Column(@Each(@Filter(agents, "status", "==", "blocked"), "a", ListItem(a.name, @ToAssistant("Answer " + a.id), false, "zed_agent", a.program + " · " + a.id, 0, [Tag("blocked", "danger")]))),
  Text("Working", "warning"),
  Column(@Each(@Filter(agents, "status", "==", "working"), "a", ListItem(a.name, @ToAssistant("Show " + a.id + " in " + current.name), false, "zed_agent", a.program + " · turn " + a.turn, 0, [Tag("working", "warning")]))),
  Text("Idle and done", "muted"),
  Column(@Each(@Filter(@Filter(agents, "status", "!=", "blocked"), "status", "!=", "working"), "a", ListItem(a.name, @ToAssistant("Show " + a.id + " in " + current.name), false, "zed_agent", a.program + " · " + a.when, 0, [Tag(a.status, a.status == "done" ? "success" : "secondary")]))),
  Button("New agent in " + wt.branch, @ToAssistant("New agent in " + wt.branch), "primary", false, "plus")
], {gap: 4})

termsView = Column([
  Column(@Each(terms, "s", ListItem(s.name, @ToAssistant("Show " + s.id + " in " + current.name), false, "terminal", s.program + " · " + s.id, 0, [Tag(s.status, "success")]))),
  Button("New terminal in " + wt.branch, @ToAssistant("New terminal in " + wt.branch), "outline", false, "plus")
], {gap: 4})

historyView = Column([
  Tabs(["All", "Agents", "Terminals"], $historyKind),
  Text("Sessions that ended. Agents resume where they stopped; a terminal reopens in its directory.", "small"),
  Column(@Each(history, "h", ListItem(h.name, @ToAssistant((h.kind == "agent" ? "Resume " : "Reopen ") + h.id), false, h.kind == "agent" ? "zed_agent" : "terminal", h.program + (h.turn > 0 ? " · " + h.turn + " turns" : "") + " · " + h.when, 0, [Tag(@First(@Filter(worktrees, "id", "==", h.worktree)).branch, "secondary")]))),
  @Count(history) == 0 ? Text("No ended session matches.", "muted") : nothing
], {gap: 4})
