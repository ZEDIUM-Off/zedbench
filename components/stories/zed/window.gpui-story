# Zed window
# A virtual Zedbench window built from Zed's own primitives: title bar, left
# dock with the Project Panel, a pane with its tabs and editor, bottom dock
# with a terminal, right dock and status bar.
#
# A story extends it with a first comment `# extends: <path to this file>`,
# then redefines only the slots it changes. A name the story defines replaces
# this file's definition and keeps its place in the window:
#   sidebar      left of the workspace, outside it (empty here)
#   titleStart   titleEnd       statusStart    statusEnd
#   leftDock     center         rightDock      bottomDock
#   project      files          tabs           buffers
# and the state $leftOpen, $rightOpen, $bottomOpen, $activeTab.

$leftOpen = true
$rightOpen = false
$bottomOpen = true
$activeTab = 0

project = {name: "acme-app", branch: "main", machine: "local"}

files = [
  {name: "src", depth: 0, icon: "folder_open", state: ""},
  {name: "main.rs", depth: 1, icon: "file_rust", state: ""},
  {name: "lib.rs", depth: 1, icon: "file_rust", state: "M"},
  {name: "tests", depth: 0, icon: "folder", state: ""},
  {name: "Cargo.toml", depth: 0, icon: "file", state: ""},
  {name: "README.md", depth: 0, icon: "file_markdown", state: ""}
]

tabs = [
  {label: "main.rs", icon: "file_rust"},
  {label: "lib.rs", icon: "file_rust", dirty: true},
  {label: "README.md", icon: "file_markdown"}
]

buffers = [
  "use acme_app::App;\n\nfn main() -> anyhow::Result<()> {\n    let app = App::new()?;\n    app.run()\n}",
  "pub struct App {\n    config: Config,\n}\n\nimpl App {\n    pub fn new() -> anyhow::Result<Self> {\n        Ok(Self { config: Config::load()? })\n    }\n}",
  "# acme-app\n\nA small example project.\n\n## Build\n\n    cargo run"
]

nothing = Column([], {width: 0})

root = Column([
  titleBar,
  Divider(),
  Row([sidebar, workspace], {grow: true, align: "stretch"}),
  Divider(),
  statusBar
], {grow: true})

sidebar = nothing

workspace = Row([
  $leftOpen ? Row([leftDock, Divider()], {align: "stretch"}) : nothing,
  Column([
    center,
    $bottomOpen ? Column([Divider(), bottomDock], {height: 200}) : nothing
  ], {grow: true}),
  $rightOpen ? Row([Divider(), rightDock], {align: "stretch"}) : nothing
], {grow: true, align: "stretch"})

titleBar = Row([
  titleStart,
  Text(project.machine, "muted"),
  Text("/", "muted"),
  Text(project.name),
  Button(project.branch, null, "ghost", false, "git_branch"),
  Spacer(),
  titleEnd
], {gap: 6, padding: 4, surface: "title_bar"})

titleStart = nothing
titleEnd = nothing

leftDock = Column([
  Row([Text(project.name, "small")], {padding: 4}),
  Column(@Each(files, "f", ListItem(f.name, null, false, f.icon, null, f.depth, f.state == "" ? [] : [Tag(f.state, "warning")])), {gap: 1})
], {width: 240, gap: 2, padding: 4, scroll: true, surface: "panel"})

center = Column([
  PaneTabs(tabs, $activeTab, [Button("", null, "ghost", false, "plus"), Button("", null, "ghost", false, "split")]),
  Editor(buffers[$activeTab], 1, 3)
], {grow: true})

bottomDock = Column([
  PaneTabs([{label: "zsh", icon: "terminal"}], 0),
  Terminal("$ cargo test\n   Compiling acme-app v0.1.0\n    Finished test profile in 3.1s\n     Running unittests src/lib.rs\ntest result: ok. 12 passed; 0 failed")
], {grow: true})

rightDock = Column([
  Text("Outline", "small"),
  ListItem("struct App", null, false, "hash", null, 0),
  ListItem("fn new", null, false, "hash", null, 1)
], {width: 260, gap: 2, padding: 4, surface: "panel"})

statusBar = Row([
  Button("", @Set($leftOpen, !$leftOpen), "ghost", $leftOpen, "file_tree"),
  Button("", @Set($bottomOpen, !$bottomOpen), "ghost", $bottomOpen, "terminal"),
  statusStart,
  Spacer(),
  Text("Ln 3, Col 5", "small"),
  Text("Rust", "small"),
  statusEnd,
  Button("", @Set($rightOpen, !$rightOpen), "ghost", $rightOpen, "list_tree")
], {gap: 4, padding: 2, surface: "status_bar"})

statusStart = nothing
statusEnd = nothing
